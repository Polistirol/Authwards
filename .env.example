# =============================================================================
# Authwards — copy to `.env` at the repository root and fill in values.
# Backend (`backend/`) and agent-runtime (`agent-runtime/`) load this file.
# Vite apps (dashboard, supply-chain-demo) read variables from the root via Vite.
# =============================================================================

# --- Backend HTTP ---
PORT=3000
BACKEND_URL=http://localhost:3000

# Frontend URL used for OAuth (post-login redirect). Must match the app you open in the browser.
# Dashboard example: http://localhost:5173
# Supply-chain demo example: http://localhost:5175
FRONTEND_URL=http://localhost:5173

# Optional: multiple origins (CSV). Useful if you use dashboard and demo together.
# FRONTEND_URLS=http://localhost:5173,http://localhost:5175

# CORS: extra origins beyond FRONTEND_URL / FRONTEND_URLS (CSV).
# ALLOWED_ORIGINS=

# --- Secrets (generate long random strings, e.g. `openssl rand -hex 32`) ---
JWT_SECRET=
PLATFORM_DERIVATION_SECRET=

# --- IOTA (node + faucet; verify current endpoints in IOTA documentation) ---
IOTA_NODE_URL=https://api.testnet.iota.cafe
IOTA_FAUCET_URL=https://faucet.testnet.iota.cafe

# Optional: DID gas budget (backend).
# DID_GAS_BUDGET=

# --- Master wallet (backend: faucet, transfer, sponsor) — use one of the options ---
# 32-byte hex private key (64 chars), IOTA SDK-supported format, or mnemonic:

MASTER_WALLET_PRIVATE_KEY=
MASTER_WALLET_SEED_PHRASE=

# MASTER_WALLET_MNEMONIC=
# Optional: verify derived address
# MASTER_WALLET_ADDRESS=

# --- Google OAuth (required to start the backend: Google strategy is always registered) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered in Google Cloud Console, e.g.:
# http://localhost:3000/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- GitHub OAuth (optional; if any of the three is missing, GitHub is not registered) ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# --- Telegram login (optional) ---
# TELEGRAM_BOT_TOKEN=


AGENT_PERMIT_PACKAGE_ID=

# --- Agent derivation / admin (optional) ---
# Used to run admin operations once deployed -removed in production1
# DEV_ACTION_SECRET=

# --- Welcome airdrop (optional) ---
WELCOME_AIRDROP_ENABLED=false
WELCOME_AIRDROP_AMOUNT=0

# --- Backend DB (optional; default `backend/db.json`) ---
# DB_PATH=
# ENV_PATH=

# --- Vite: API URL (usually same as BACKEND_URL) ---
VITE_BACKEND_URL=http://localhost:3000

# Supply-chain demo: dashboard link and “frontend” URL for QR / deep links
VITE_DASHBOARD_URL=http://localhost:5173
# If you only serve supply-chain-demo, align FRONTEND_URL above with this port too.
VITE_FRONTEND_URL=http://localhost:5175

# --- Agent runtime (separate process; shares JWT and DB with the backend) ---
# Required in agent-runtime: JWT_SECRET, IOTA_NODE_URL (set above)-- not used in published version.
AGENT_POLL_INTERVAL_MS=10000
AGENT_DB_POLL_MS=10000


# --- Other (optional) ---
# BACKEND_URL is already set; used in agent snippets.
# CORS_STRICT_ORIGINS=false
# LOG_HTTP_VERBOSE=false
